<script>
(() => {
  const pill = document.getElementById('callPill');
  const seamGlint = document.getElementById('seamGlint');
  const trailEmerald = document.getElementById('trailEmerald');
  const trailCrimson = document.getElementById('trailCrimson');
  const btnPick = document.getElementById('btnPick');
  const btnDecline = document.getElementById('btnDecline');
  const callerCenter = document.getElementById('callerCenter');
  const dragHint = document.getElementById('dragHint');
  const chevLeft = document.getElementById('chevLeft');
  const chevRight = document.getElementById('chevRight');
  const callTimer = document.getElementById('callTimer');
  const btnMute = document.getElementById('btnMute');
  const btnSpeaker = document.getElementById('btnSpeaker');
  const btnEnd = document.getElementById('btnEnd');

  let timerInterval = null;
  let seconds = 0;
  let audioCtx = null;

  // Hook these into your existing Call App functions
  const CallHooks = {
    onAnswerCall: () => console.log('Answer call triggered'),
    onDeclineCall: () => console.log('Decline call triggered'),
    onEndCall: () => console.log('End call triggered'),
    onToggleMute: (muted) => console.log('Mute:', muted),
    onToggleSpeaker: (speaker) => console.log('Speaker:', speaker),
  };

  function playTick(freq = 880) {
    try {
      audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.06);
      osc.connect(gain); gain.connect(audioCtx.destination);
      osc.start(); osc.stop(audioCtx.currentTime + 0.06);
      if (navigator.vibrate) navigator.vibrate(14);
    } catch {}
  }

  function showIncomingCall({ name = 'Rahul Verma', initials = 'RV', subtitle = 'Incoming Call' } = {}) {
    clearInterval(timerInterval);
    document.getElementById('orbAvatar').textContent = initials;
    document.getElementById('activeAvatar').textContent = initials;
    document.getElementById('callerName').textContent = name;
    document.getElementById('activeName').textContent = name;
    document.getElementById('callerSub').textContent = subtitle;

    pill.className = 'call-pill-shell';
    resetDragVisuals();

    // Stage 1: Drop 68x68 RV orb
    requestAnimationFrame(() => {
      pill.classList.add('state-drop');
      // Stage 2: Unfold center-to-sides
      setTimeout(() => {
        seamGlint.classList.remove('flash');
        void seamGlint.offsetWidth;
        seamGlint.classList.add('flash');
        pill.classList.remove('state-drop');
        pill.classList.add('state-expanded');
      }, 460);
    });
  }

  function answerCall() {
    CallHooks.onAnswerCall();
    resetDragVisuals();
    pill.classList.remove('state-expanded');
    pill.classList.add('state-active');
    seconds = 0;
    callTimer.textContent = '00:00';
    clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      seconds++;
      const m = String(Math.floor(seconds / 60)).padStart(2, '0');
      const s = String(seconds % 60).padStart(2, '0');
      callTimer.textContent = `${m}:${s}`;
    }, 1000);
  }

  function dismissCall(isEndCall = false) {
    clearInterval(timerInterval);
    isEndCall ? CallHooks.onEndCall() : CallHooks.onDeclineCall();
    resetDragVisuals();
    // Collapse both sides back into 68x68 RV orb, then retract upward
    pill.classList.remove('state-expanded', 'state-active');
    pill.classList.add('state-collapse');
    setTimeout(() => {
      pill.classList.remove('state-collapse');
      pill.classList.add('state-retract');
    }, 430);
  }

  function resetDragVisuals() {
    [btnPick, btnDecline].forEach((b) => {
      b.classList.remove('dragging');
      b.style.transform = '';
      b.style.opacity = '';
    });
    trailEmerald.style.width = '0px'; trailEmerald.style.opacity = '0';
    trailCrimson.style.width = '0px'; trailCrimson.style.opacity = '0';
    callerCenter.style.opacity = '';
    chevLeft.style.opacity = '';
    chevRight.style.opacity = '';
    dragHint.className = 'drag-hint';
    pill.classList.remove('glow-emerald', 'glow-crimson');
  }

  function attachDrag(btn, type) {
    const isPick = type === 'pick';
    const otherBtn = isPick ? btnDecline : btnPick;
    const trail = isPick ? trailEmerald : trailCrimson;
    let startX = 0, currentDx = 0, maxTravel = 180, crossed = false, moved = false;

    btn.addEventListener('pointerdown', (e) => {
      if (!pill.classList.contains('state-expanded')) return;
      btn.setPointerCapture(e.pointerId);
      btn.classList.add('dragging');
      startX = e.clientX;
      currentDx = 0;
      crossed = false;
      moved = false;
      maxTravel = Math.max(120, pill.clientWidth - 76);
    });

    btn.addEventListener('pointermove', (e) => {
      if (!btn.classList.contains('dragging')) return;
      const rawDx = e.clientX - startX;
      const dx = isPick ? Math.max(0, Math.min(maxTravel, rawDx)) : Math.min(0, Math.max(-maxTravel, rawDx));
      if (Math.abs(dx) > 4) moved = true;
      currentDx = dx;

      const progress = Math.abs(dx) / maxTravel;
      btn.style.transform = `translate(${dx}px, -50%) scale(${1 + progress * 0.08})`;
      otherBtn.style.opacity = String(Math.max(0, 1 - progress * 2.2));
      callerCenter.style.opacity = String(Math.max(0, 1 - progress * 3));
      chevLeft.style.opacity = '0';
      chevRight.style.opacity = '0';

      trail.style.width = `${Math.abs(dx) + 64}px`;
      trail.style.opacity = String(Math.min(1, progress * 1.4));

      dragHint.classList.add('visible');
      if (progress >= 0.55) {
        if (!crossed) { crossed = true; playTick(isPick ? 980 : 520); }
        dragHint.textContent = isPick ? 'RELEASE TO ANSWER' : 'RELEASE TO DECLINE';
        dragHint.className = `drag-hint visible ${isPick ? 'ready-emerald' : 'ready-crimson'}`;
        pill.classList.add(isPick ? 'glow-emerald' : 'glow-crimson');
      } else {
        crossed = false;
        dragHint.textContent = isPick ? 'SLIDE TO ANSWER »' : '« SLIDE TO DECLINE';
        dragHint.className = 'drag-hint visible';
        pill.classList.remove('glow-emerald', 'glow-crimson');
      }
    });

    function finishDrag() {
      if (!btn.classList.contains('dragging')) return;
      btn.classList.remove('dragging');
      const progress = Math.abs(currentDx) / maxTravel;

      if (!moved) {
        // Tap-to-nudge hint
        const nudge = isPick ? 18 : -18;
        btn.style.transition = 'transform 160ms ease-out';
        btn.style.transform = `translate(${nudge}px, -50%)`;
        callerCenter.style.opacity = '0';
        dragHint.textContent = 'DRAG SIDEWAYS';
        dragHint.className = 'drag-hint visible';
        setTimeout(() => {
          btn.style.transition = '';
          resetDragVisuals();
        }, 650);
        return;
      }

      if (progress >= 0.55) {
        isPick ? answerCall() : dismissCall(false);
      } else {
        resetDragVisuals();
      }
    }

    btn.addEventListener('pointerup', finishDrag);
    btn.addEventListener('pointercancel', finishDrag);
  }

  attachDrag(btnPick, 'pick');
  attachDrag(btnDecline, 'decline');

  btnMute.addEventListener('click', () => {
    const on = btnMute.classList.toggle('on');
    CallHooks.onToggleMute(on);
  });
  btnSpeaker.addEventListener('click', () => {
    const on = btnSpeaker.classList.toggle('on');
    CallHooks.onToggleSpeaker(on);
  });
  btnEnd.addEventListener('click', () => dismissCall(true));

  // Trigger demo on load (replace with your real incoming call event)
