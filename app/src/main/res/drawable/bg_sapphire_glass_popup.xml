<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft sapphire ambient rim glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A38BDF8" />
            <corners android:radius="29dp" />
        </shape>
    </item>
    <!-- Primary smoked-sapphire 3D glass body with glowing platinum-cyan border -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#F20D1426"
                android:endColor="#F5080D1A"
                android:startColor="#F016223D"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.25dp"
                android:color="#6660A5FA" />
        </shape>
    </item>
    <!-- Subtle top specular glass sheen -->
    <item
        android:bottom="160dp"
        android:left="3dp"
        android:right="3dp"
        android:top="2.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1FFFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
        </shape>
    </item>
</layer-list>
