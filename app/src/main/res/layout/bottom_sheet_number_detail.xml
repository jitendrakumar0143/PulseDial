<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header: Avatar, Contact Name / Unsaved, Phone Number, Star/Blocked badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_detail_avatar"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_avatar"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/md_theme_onPrimaryContainer"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/detail_unsaved_number"
                android:textColor="@color/md_theme_onSurface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="13sp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_detail_blocked"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clickable="false"
                android:text="@string/detail_blocked_badge"
                android:textColor="@color/md_theme_onErrorContainer"
                android:visibility="gone"
                app:chipBackgroundColor="@color/md_theme_errorContainer"
                app:chipStrokeWidth="0dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_detail_star"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_toggle_favorite"
            android:src="@drawable/ic_star_outline"
            android:visibility="gone"
            app:tint="@color/md_theme_tertiary" />
    </LinearLayout>

    <!-- Structured Caller Geo (Location, State, ZIP/PIN, Country) & Social Lookup Strip -->
    <LinearLayout
        android:id="@+id/layout_sheet_caller_geo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_icon_pill_tonal"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_sheet_geo_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/md_theme_onSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sheet_social_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sheet_whatsapp"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/caller_id_social_whatsapp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sheet_telegram"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minHeight="48dp"
                    android:text="@string/caller_id_social_telegram" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_sheet_web"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minHeight="48dp"
                    android:text="@string/caller_id_social_web" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Essential Quick Actions Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Call -->
        <LinearLayout
            android:id="@+id/action_detail_call"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/detail_action_call"
                android:src="@drawable/ic_call"
                app:tint="@color/call_accept_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/detail_action_call"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/md_theme_onSurface" />
        </LinearLayout>

        <!-- Message / SMS -->
        <LinearLayout
            android:id="@+id/action_detail_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/detail_action_message"
                android:src="@drawable/ic_message"
                app:tint="@color/md_theme_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/detail_action_message"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/md_theme_onSurface" />
        </LinearLayout>

        <!-- Save Number -->
        <LinearLayout
            android:id="@+id/action_detail_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/detail_action_save"
                android:src="@drawable/ic_person_add"
                app:tint="@color/md_theme_primary" />

            <TextView
                android:id="@+id/tv_detail_save_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/detail_action_save"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/md_theme_onSurface" />
        </LinearLayout>

        <!-- Copy -->
        <LinearLayout
            android:id="@+id/action_detail_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/detail_action_copy"
                android:src="@drawable/ic_content_copy"
                app:tint="@color/md_theme_onSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/detail_action_copy"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/md_theme_onSurface" />
        </LinearLayout>

        <!-- Block / Unblock -->
        <LinearLayout
            android:id="@+id/action_detail_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/iv_detail_block"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/detail_action_block"
                android:src="@drawable/ic_block"
                app:tint="@color/md_theme_error" />

            <TextView
                android:id="@+id/tv_detail_block_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/detail_action_block"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/md_theme_onSurface" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp" />

    <!-- Call History for this Specific Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detail_history_header"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="@color/md_theme_primary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_number_history"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tv_detail_history_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:text="@string/detail_history_empty"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:visibility="gone" />

</LinearLayout>
