<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popup_root_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/card_popup_glass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sapphire_glass_popup"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Badge Row + Clean Close (×) Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_popup_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sapphire_badge_update"
                android:letterSpacing="0.06"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="@string/popup_badge_app_update"
                android:textColor="#6EE7B7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_popup_version_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_sapphire_badge_update"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="#E2F8FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_popup_close_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_sapphire_close_circle"
                android:clickable="true"
                android:contentDescription="@string/popup_close_button_cd"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="×"
                android:textColor="#E2E8F0"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Optional Ad / Update Hero Image -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_popup_image_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="#111827"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:rippleColor="#3360A5FA"
            app:strokeColor="#4060A5FA"
            app:strokeWidth="1dp">

            <FrameLayout
                android:id="@+id/frame_popup_image_inner"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_popup_image"
                    android:layout_width="match_parent"
                    android:layout_height="204dp"
                    android:contentDescription="@string/broadcast_image_cd"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tv_popup_image_link_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_sapphire_badge_update"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Open ↗"
                    android:textColor="#E2F8FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Title & Description -->
        <TextView
            android:id="@+id/tv_popup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#F8FAFC"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_popup_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_popup_force_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/popup_force_update_hint"
            android:textColor="#FCA5A5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Primary Glass CTA + Secondary Dismiss -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_popup_action"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#10B981"
            app:cornerRadius="16dp"
            app:strokeColor="#66A7F3D0"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_popup_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/dialog_close"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
