<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_3d_popup"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: 3D Badge + Caller Name + Live Call Timer / Ringing Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_notif_btn_answer_3d"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_call"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_notif_popup_caller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notif_popup_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#BAE6FD"
                android:textSize="12sp" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/chrono_notif_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notif_btn_glass_3d"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="#6EE7B7"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Essential Call Info Strip (SIM • Audio Route • Recording Status • Location) -->
    <TextView
        android:id="@+id/tv_notif_popup_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_notif_btn_glass_3d"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="#E2E8F0"
        android:textSize="12sp" />

    <!-- Quick Action Buttons inside Upper-Side / Pull-Down 3D Popup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_notif_mute"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn_glass_3d"
            android:text="@string/incall_mute"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_notif_speaker"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn_glass_3d"
            android:text="@string/incall_speaker"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_notif_end"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn_decline_3d"
            android:text="@string/incall_end_call"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
