<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_3d_popup"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_notif_btn_answer_3d"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_call"
        android:tint="#FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_notif_compact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_notif_compact_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/chrono_notif_compact_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_notif_btn_glass_3d"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#6EE7B7"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
