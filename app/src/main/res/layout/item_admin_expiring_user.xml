<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_expiring_user"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/md_theme_errorContainer"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/md_theme_error"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_expiring_urgency_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/md_theme_onErrorContainer"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_expiring_days_left"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                app:chipBackgroundColor="@color/md_theme_error"
                app:chipStrokeWidth="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_expiring_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/md_theme_onSurface" />

        <TextView
            android:id="@+id/tv_expiring_user_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <TextView
            android:id="@+id/tv_expiring_user_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/md_theme_onSurface" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_expiring_minus_7"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="56dp"
                    android:text="@string/admin_day_minus_7"
                    android:textColor="@color/md_theme_error"
                    app:strokeColor="@color/md_theme_error" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_expiring_minus_1"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="56dp"
                    android:text="@string/admin_day_minus_1"
                    android:textColor="@color/md_theme_error"
                    app:strokeColor="@color/md_theme_error" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_expiring_plus_7"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="56dp"
                    android:text="@string/admin_day_plus_7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_expiring_renew"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/admin_renew_30d" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_expiring_manage"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/admin_manage_user" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_expiring_revoke"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/admin_revoke_pro"
                    android:textColor="@color/md_theme_error" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
