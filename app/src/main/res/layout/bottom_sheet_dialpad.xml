<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Minimalist M3 Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Live T9 Contact & History Suggestions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_t9_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Quick Action Chips: Paste / Save Contact -->
    <LinearLayout
        android:id="@+id/layout_dialpad_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_paste_number"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minHeight="48dp"
            android:text="@string/dialpad_paste"
            android:visibility="gone"
            app:chipCornerRadius="20dp"
            app:chipIcon="@drawable/ic_content_paste"
            app:chipIconTint="@color/md_theme_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_add_contact"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minHeight="48dp"
            android:text="@string/dialpad_add_contact"
            android:visibility="gone"
            app:chipCornerRadius="20dp"
            app:chipIcon="@drawable/ic_person_add"
            app:chipIconTint="@color/md_theme_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_lookup_caller_id"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/dialpad_lookup_caller_id"
            android:visibility="gone"
            app:chipCornerRadius="20dp" />
    </LinearLayout>

    <!-- Premium VIP 3D Header Badge (visible for active Premium subscribers) -->
    <TextView
        android:id="@+id/tv_dialpad_vip_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.06"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp"
        android:text="👑 VIP 3D DIALER"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Minimalist Material 3 Number Display Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_dialpad_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_theme_surfaceVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp">

                <EditText
                    android:id="@+id/et_dialpad_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="@string/dialpad_hint"
                    android:inputType="phone"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/md_theme_onSurface"
                    android:textColorHint="@color/md_theme_onSurfaceVariant"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_dialpad_backspace"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dialpad_backspace"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/md_theme_onSurfaceVariant" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_dialpad_caller_id_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingHorizontal="14dp"
                android:paddingBottom="6dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/md_theme_primary"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Clean, Minimalist Material 3 0-9 Numeric Keypad Grid -->
    <GridLayout
        android:id="@+id/grid_dialpad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4">

        <!-- 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="1"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:rippleColor="@color/md_theme_primaryContainer"
            app:strokeColor="@color/md_theme_surfaceVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="•"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2 ABC -->
