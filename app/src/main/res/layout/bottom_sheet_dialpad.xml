                    android:text=";"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_dialpad_sim"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/dialpad_sim_chip_default"
            android:minHeight="48dp"
            android:text="@string/dialpad_sim_chip_default"
            android:visibility="gone"
            app:chipCornerRadius="24dp"
            app:chipIcon="@drawable/ic_sim_card"
            app:chipIconTint="@color/md_theme_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialpad_call"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/action_call"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="@color/call_accept_green"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_call"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
