<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="42dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Live T9 Contact & History Suggestions -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_t9_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Quick Action Chips: Paste / Save Contact -->
    <LinearLayout
        android:id="@+id/layout_dialpad_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_paste_number"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/dialpad_paste"
            android:visibility="gone"
            app:chipIcon="@drawable/ic_content_paste" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_add_contact"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialpad_add_contact"
            android:visibility="gone"
            app:chipIcon="@drawable/ic_person_add" />
    </LinearLayout>

    <!-- Number Display + Backspace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <EditText
            android:id="@+id/et_dialpad_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:focusable="false"
            android:gravity="center"
            android:hint="@string/dialpad_hint"
            android:inputType="phone"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textColor="@color/md_theme_onSurface"
            android:textColorHint="@color/md_theme_onSurfaceVariant"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_dialpad_backspace"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dialpad_backspace"
            android:src="@drawable/ic_backspace"
            app:tint="@color/md_theme_onSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        app:dividerColor="@color/md_theme_surfaceVariant" />

    <!-- Tactile Material 3 Dialpad Grid -->
    <GridLayout
        android:id="@+id/grid_dialpad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4">

        <!-- 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_1"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="1"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text=" "
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2 ABC -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_2"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="2 ABC"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="ABC"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3 DEF -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_3"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="3 DEF"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="DEF"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4 GHI -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_4"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="4 GHI"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="GHI"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5 JKL -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_5"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="5 JKL"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="JKL"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6 MNO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_6"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="6 MNO"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="MNO"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7 PQRS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_7"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="7 PQRS"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="PQRS"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 8 TUV -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_8"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="8 TUV"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="TUV"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 9 WXYZ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_9"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="9 WXYZ"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="WXYZ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- * (Long press: , pause) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_star"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="Star"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=","
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 0 + -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_0"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="0 plus"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- # (Long press: ; wait) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_hash"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
            android:contentDescription="Pound"
            android:focusable="true"
            app:cardBackgroundColor="@color/md_theme_surfaceContainer"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=";"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialpad_call"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/action_call"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/call_accept_green"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_call"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF" />
</LinearLayout>
