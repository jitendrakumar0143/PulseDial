        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_key_7"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:clickable="true"
